# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml.
# Copy this file to .kamal/secrets (which is gitignored) and populate or fetch from your secret store.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

APP_KEY=$APP_KEY
APP_URL=$APP_URL

DB_PASSWORD=$DB_PASSWORD
POSTGRES_PASSWORD=$DB_PASSWORD

# config/deploy.yml's builder.args also reads REVERB_APP_KEY, REVERB_HOST, REVERB_PORT and
# REVERB_SCHEME, but via ERB evaluated by the kamal CLI against the shell environment of
# whoever runs it - NOT from this file. Export them in that shell before `kamal build`/
# `kamal deploy` (e.g. `set -a; source .env.production; set +a`), or the build fails:
# REVERB_APP_KEY and REVERB_HOST have no fallback and raise KeyError if unset.
REVERB_APP_ID=$REVERB_APP_ID
REVERB_APP_KEY=$REVERB_APP_KEY
REVERB_APP_SECRET=$REVERB_APP_SECRET
REVERB_HOST=$REVERB_HOST
REVERB_PORT=${REVERB_PORT:-443}
REVERB_SCHEME=${REVERB_SCHEME:-https}

RUSTFS_ACCESS_KEY=$RUSTFS_ACCESS_KEY
RUSTFS_SECRET_KEY=$RUSTFS_SECRET_KEY

AWS_ACCESS_KEY_ID=$RUSTFS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=$RUSTFS_SECRET_KEY
AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-us-east-1}
AWS_BUCKET=${AWS_BUCKET:-forum}
AWS_ENDPOINT=$AWS_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=${AWS_USE_PATH_STYLE_ENDPOINT:-true}
