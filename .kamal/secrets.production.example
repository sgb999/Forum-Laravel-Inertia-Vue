# Production secrets (`kamal <cmd> -d production`).
# Copy this file to .kamal/secrets.production (gitignored) and populate or fetch from your secret store.
# Production owns the shared `forum-postgres` and `forum-rustfs` accessory containers.
# Keep POSTGRES_PASSWORD (the `forum_admin` Postgres cluster superuser) distinct from
# DB_PASSWORD (the non-superuser `forum_production` application role), and keep
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (scoped to the `forum-production` bucket)
# distinct from RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY (the RustFS accessory admin account).

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

APP_KEY=$PRODUCTION_APP_KEY
APP_URL=${PRODUCTION_APP_URL:-https://forum.example.com}

DB_PASSWORD=$PRODUCTION_DB_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_ADMIN_PASSWORD
# Injected into the `forum-postgres` accessory container via `accessories.postgres.env.secret`
# so `/usr/local/bin/init-staging.sh` reads both role passwords from the accessory environment
# instead of receiving them on the `kamal accessory exec` command line.
PRODUCTION_DB_PASSWORD=$PRODUCTION_DB_PASSWORD
STAGING_DB_PASSWORD=$STAGING_DB_PASSWORD

# config/deploy.yml's builder.args and reverb.proxy.host also read REVERB_APP_KEY, REVERB_HOST,
# REVERB_PORT and REVERB_SCHEME via ERB evaluated by the kamal CLI against the shell environment
# of whoever runs it - NOT from this file. Export them in that shell before `kamal build`/
# `kamal deploy` (e.g. `set -a; source .env.production.deploy; set +a`), or the build fails:
# REVERB_APP_KEY and REVERB_HOST have no fallback and raise KeyError if unset or blank.
REVERB_APP_ID=$PRODUCTION_REVERB_APP_ID
REVERB_APP_KEY=$REVERB_APP_KEY
REVERB_APP_SECRET=$PRODUCTION_REVERB_APP_SECRET
REVERB_HOST=$REVERB_HOST
REVERB_PORT=${REVERB_PORT:-443}
REVERB_SCHEME=${REVERB_SCHEME:-https}

RUSTFS_ACCESS_KEY=$RUSTFS_ACCESS_KEY
RUSTFS_SECRET_KEY=$RUSTFS_SECRET_KEY

AWS_ACCESS_KEY_ID=$PRODUCTION_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$PRODUCTION_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-us-east-1}
AWS_BUCKET=${PRODUCTION_AWS_BUCKET:-forum-production}
AWS_ENDPOINT=${AWS_ENDPOINT:-http://forum-rustfs:9000}
AWS_USE_PATH_STYLE_ENDPOINT=${AWS_USE_PATH_STYLE_ENDPOINT:-true}
