# Staging secrets (`kamal <cmd> -d staging`).
# Copy this file to .kamal/secrets.staging (gitignored) and populate or fetch from your secret store.
# Staging connects to the shared `forum-postgres` accessory container (owned by production)
# using the `forum_staging` role and `forum_staging` database created by `docker/postgres/init-staging.sh`.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

APP_KEY=$STAGING_APP_KEY
APP_URL=${STAGING_APP_URL:-https://staging.forum.example.com}

DB_PASSWORD=$STAGING_DB_PASSWORD

# config/deploy.yml's builder.args and reverb.proxy.host also read REVERB_APP_KEY, REVERB_HOST,
# REVERB_PORT and REVERB_SCHEME via ERB evaluated by the kamal CLI against the shell environment
# of whoever runs it - NOT from this file. Export them in that shell before `kamal build`/
# `kamal deploy` (e.g. `set -a; source .env.staging.deploy; set +a`), or the build fails:
# REVERB_APP_KEY and REVERB_HOST have no fallback and raise KeyError if unset or blank.
REVERB_APP_ID=$STAGING_REVERB_APP_ID
REVERB_APP_KEY=$REVERB_APP_KEY
REVERB_APP_SECRET=$STAGING_REVERB_APP_SECRET
REVERB_HOST=$REVERB_HOST
REVERB_PORT=${REVERB_PORT:-443}
REVERB_SCHEME=${REVERB_SCHEME:-https}

AWS_ACCESS_KEY_ID=$STAGING_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$STAGING_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-us-east-1}
AWS_BUCKET=${STAGING_AWS_BUCKET:-forum-staging}
AWS_ENDPOINT=${AWS_ENDPOINT:-http://forum-rustfs:9000}
AWS_USE_PATH_STYLE_ENDPOINT=${AWS_USE_PATH_STYLE_ENDPOINT:-true}
